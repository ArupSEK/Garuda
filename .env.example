ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/garuda.db
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=480
MAX_CIDR_PREFIX=24
MAX_TARGETS=256
SCAN_CONCURRENCY=2
DEFAULT_RATE_LIMIT=100
COMMAND_TIMEOUT=1800
EVIDENCE_DIR=./evidence
REPORT_DIR=./reports
LOG_LEVEL=INFO
NMAP_PATH=nmap
NAABU_PATH=naabu
HTTPX_PATH=httpx-pd
NUCLEI_PATH=nuclei
NUCLEI_TEMPLATES_PATH=/home/scanner/nuclei-templates
TESTSSL_PATH=testssl.sh
SSH_AUDIT_PATH=ssh-audit
DNSX_PATH=dnsx
GOWITNESS_PATH=gowitness
SCANNER_VERSIONS=
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
CISA_KEV_CACHE_PATH=./data/cisa_kev.json
INTELLIGENCE_REFRESH_HOURS=24
INTELLIGENCE_TIMEOUT=15
RETENTION_DAYS=365
GARUDA_API_PORT=8000
GARUDA_DASHBOARD_PORT=8501
